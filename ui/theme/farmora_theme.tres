NumberLabel/font_sizes/font_size = 18

; A type variation name is unique per Theme regardless of base type, so
; the Label (font color) and PanelContainer (background) halves of each
; toast "kind" need distinct variation names -- "ToastXLabel" vs
; "ToastXPanel" -- even though both are conceptually "the Success toast".
; Label (Godot 4) has no stylebox theme item of its own, only font/color/
; constant items, which is why the background must live on a separate
; PanelContainer variation (see ui/components/toast/toast.tscn and .gd).
ToastSuccessLabel/base_type = &"Label"
ToastSuccessLabel/colors/font_color = Color(1.0, 1.0, 1.0, 1.0)
ToastSuccessLabel/font_sizes/font_size = 14

ToastProblemLabel/base_type = &"Label"
ToastProblemLabel/colors/font_color = Color(0.47843137383461, 0.16470588743687, 0.10588235408068, 1.0)
ToastProblemLabel/font_sizes/font_size = 14

ToastInfoLabel/base_type = &"Label"
ToastInfoLabel/colors/font_color = Color(1.0, 1.0, 1.0, 1.0)
ToastInfoLabel/font_sizes/font_size = 14

ToastSuccessPanel/base_type = &"PanelContainer"
ToastSuccessPanel/styles/panel = SubResource("StyleBoxFlat_toast_success")

ToastProblemPanel/base_type = &"PanelContainer"
ToastProblemPanel/styles/panel = SubResource("StyleBoxFlat_toast_problem")

ToastInfoPanel/base_type = &"PanelContainer"
ToastInfoPanel/styles/panel = SubResource("StyleBoxFlat_toast_info")

Panel/styles/panel = SubResource("StyleBoxFlat_icon_button")
