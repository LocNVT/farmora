[resource]
; NOTE (Phase 0): No custom FontFile is assigned anywhere in this theme.
; docs/DESIGN.md Section 3 specifies Fredoka (600/700) and Nunito (600/700),
; which are not yet present in assets/fonts/. Every type variation below
; therefore uses the Godot default font as a documented, replaceable
; fallback. See assets/fonts/README.md for the swap-in procedure. Sizes
; and weights-by-usage still follow DESIGN.md Section 3; only the font
; family itself is temporary.
default_font_size = 15

; A type variation is registered with its own "<VariationName>/base_type
; = &"<BaseType>"" line (verified against Godot 4.7 by round-tripping a
; Theme built with Theme.set_type_variation() through ResourceSaver --
; the serialized format is flat "<VariationName>/category/item" keys
; plus this one base_type pointer, NOT a "<BaseType>/<VariationName>/..."
; nested path and NOT a top-level "type_variations" dictionary; both of
; those were tried first and silently failed to register).
;
; All Color(...) literals below use the same full-precision float values
; UiTokens' Color("#HEX") constants resolve to at runtime (.tres text
; resources do not accept the Color("#HEX") string-constructor form --
; verified directly -- only numeric Color(r,g,b,a)). Truncating these to
; 7-8 significant digits by hand previously caused a real, if tiny,
; mismatch between this file and ui_tokens.gd that one GUT test caught
; (SecondaryButton's fill compared unequal despite printing identically).
; Keep full precision here; do not round these values.

Button/colors/font_color = Color(1.0, 1.0, 1.0, 1.0)
Button/colors/font_pressed_color = Color(1.0, 1.0, 1.0, 1.0)
Button/colors/font_disabled_color = Color(0.43137255311012, 0.35294118523598, 0.27450981736183, 1.0)
Button/font_sizes/font_size = 16
Button/styles/normal = SubResource("StyleBoxFlat_primary")
Button/styles/pressed = SubResource("StyleBoxFlat_primary_pressed")
Button/styles/hover = SubResource("StyleBoxFlat_primary")
Button/styles/disabled = SubResource("StyleBoxFlat_primary_disabled")
Button/styles/focus = SubResource("StyleBoxFlat_primary")

PrimaryButton/base_type = &"Button"
PrimaryButton/colors/font_color = Color(1.0, 1.0, 1.0, 1.0)
PrimaryButton/colors/font_disabled_color = Color(0.43137255311012, 0.35294118523598, 0.27450981736183, 1.0)
PrimaryButton/font_sizes/font_size = 16
PrimaryButton/styles/normal = SubResource("StyleBoxFlat_primary")
PrimaryButton/styles/pressed = SubResource("StyleBoxFlat_primary_pressed")
PrimaryButton/styles/hover = SubResource("StyleBoxFlat_primary")
PrimaryButton/styles/disabled = SubResource("StyleBoxFlat_primary_disabled")
PrimaryButton/styles/focus = SubResource("StyleBoxFlat_primary")

SecondaryButton/base_type = &"Button"
SecondaryButton/colors/font_color = Color(0.29019609093666, 0.1843137294054, 0.07058823853731, 1.0)
SecondaryButton/colors/font_disabled_color = Color(0.43137255311012, 0.35294118523598, 0.27450981736183, 1.0)
SecondaryButton/font_sizes/font_size = 16
SecondaryButton/styles/normal = SubResource("StyleBoxFlat_secondary")
SecondaryButton/styles/pressed = SubResource("StyleBoxFlat_secondary_pressed")
SecondaryButton/styles/hover = SubResource("StyleBoxFlat_secondary")
SecondaryButton/styles/disabled = SubResource("StyleBoxFlat_primary_disabled")
SecondaryButton/styles/focus = SubResource("StyleBoxFlat_secondary")

GhostButton/base_type = &"Button"
GhostButton/colors/font_color = Color(0.23137255012989, 0.16470588743687, 0.10196078568697, 1.0)
GhostButton/colors/font_disabled_color = Color(0.43137255311012, 0.35294118523598, 0.27450981736183, 1.0)
GhostButton/font_sizes/font_size = 16
GhostButton/styles/normal = SubResource("StyleBoxFlat_ghost")
GhostButton/styles/pressed = SubResource("StyleBoxFlat_ghost_pressed")
GhostButton/styles/hover = SubResource("StyleBoxFlat_ghost")
GhostButton/styles/disabled = SubResource("StyleBoxFlat_primary_disabled")
GhostButton/styles/focus = SubResource("StyleBoxFlat_ghost")

IconButton/base_type = &"Button"
IconButton/colors/font_color = Color(0.23137255012989, 0.16470588743687, 0.10196078568697, 1.0)
IconButton/font_sizes/font_size = 16
